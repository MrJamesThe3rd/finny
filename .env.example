DB_HOST=localhost
DB_PORT=5432
DB_USER=finny
DB_PASSWORD=secret
DB_NAME=finny
AUTH_JWTSECRET=

# Root directory every local document backend is confined to.
STORAGE_LOCALROOT=./data/documents
# Set true if your Paperless runs on localhost or your LAN, which the SSRF
# guard otherwise refuses to reach.
STORAGE_ALLOWPRIVATEBACKENDHOSTS=false
